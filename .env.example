ENV=development
PORT=8200
BASE_URL=http://localhost:8200

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=VoiceAI

# Comma-separated. Must NOT contain "*" in production.
CORS_ALLOWED_ORIGINS=

# Comma-separated. Must NOT be "*" in production.
ALLOWED_HOSTS=*

# Retell vendor adapter — required in production. Also doubles as the
# webhook-signature-verification secret for X-Retell-Signature on both
# POST /webhooks/retell/inbound and /post-call (Retell's own current scheme
# HMACs with the API key itself, NOT a separate webhook secret — see
# app/routers/webhooks.py's module docstring for the full sourced reasoning).
# Unset is allowed in dev/test (unverified requests pass through); required
# in production — see Settings.assert_production_secrets().
RETELL_API_KEY=
RETELL_API_BASE=https://api.retellai.com

# Internal admin credential — authenticates VoiceAI's OWN team (not a
# regular platform) to admin-only endpoints, e.g. POST /platforms (create a
# new platform + issue its API key). A single shared secret, not a
# per-admin-account system — see app/deps.py's get_admin_caller docstring
# for the full reasoning. Pick a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Unset is allowed in dev/test (POST /platforms simply always rejects until
# set); required in production — see Settings.assert_production_secrets().
ADMIN_API_KEY=

# Re-hosting storage for call recordings/transcripts (Phase 1 item 15 —
# "re-host, don't pass through"). Required in production.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1
